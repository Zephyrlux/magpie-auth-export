{
  "name": "magpie-auth-export",
  "version": "0.1.7",
  "description": "Export saved Magpie credentials to local Codex, CLIProxyAPI or original JSON files.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "magpie-auth-export": "cli.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node cli.js serve"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": [
    "magpie-plugin",
    "magpie",
    "auth-export"
  ],
  "files": [
    "index.js",
    "cli.js",
    "lib",
    "page",
    "tests",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "install.sh"
  ],
  "magpie": {
    "page": {
      "title": "Export credentials",
      "titles": {
        "zh": "导出认证",
        "zh-TW": "匯出認證"
      },
      "file": "page/download.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 34821,
        "option": "port"
      }
    },
    "actions": [
      {
        "id": "export-auth",
        "menu": "provider",
        "title": "↓ Export credentials",
        "titles": {
          "zh": "↓ 导出认证文件",
          "zh-TW": "↓ 匯出認證檔案"
        }
      }
    ],
    "options": {
      "port": 34821
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zephyrlux/magpie-auth-export.git"
  },
  "homepage": "https://github.com/Zephyrlux/magpie-auth-export#readme",
  "bugs": {
    "url": "https://github.com/Zephyrlux/magpie-auth-export/issues"
  }
}
